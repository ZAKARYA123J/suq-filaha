<div class="min-h-screen bg-gray-100">
  <%= if assigns[:current_user] || assigns[:profile] do %>
    <% user = assigns[:profile] || assigns[:current_user] || %{} %>
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="h-16 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="h-9 w-9 rounded-lg bg-green-600 flex items-center justify-center text-white font-semibold">
              <%= String.at(user["name"] || "U", 0) %>
            </div>
            <div class="leading-tight">
              <div class="text-sm font-semibold text-gray-900"><%= user["name"] || "Account" %></div>
              <%= if user["phoneNumber"] do %>
                <div class="text-xs text-gray-500"><%= user["phoneNumber"] %></div>
              <% end %>
            </div>

            <%= if user["userType"] do %>
              <span class={"ml-2 px-2 py-1 rounded-full text-[11px] font-semibold #{if user["userType"] == "FARMER", do: "bg-green-50 text-green-700 border border-green-100", else: "bg-blue-50 text-blue-700 border border-blue-100"}"}>
                <%= user["userType"] %>
              </span>
            <% end %>
          </div>

          <nav class="hidden sm:flex items-center gap-2">
            <.link navigate={~p"/dashboard"} class={"px-3 py-2 rounded-md text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100"}>
              Dashboard
            </.link>
            <.link navigate={~p"/dashboard/negotiations"} class={"px-3 py-2 rounded-md text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100"}>
              Negotiations
            </.link>
            <%= if user["userType"] == "FARMER" do %>
              <.link navigate={~p"/dashboard/products"} class={"px-3 py-2 rounded-md text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100"}>
                Products
              </.link>
            <% end %>
            <.link navigate={~p"/products"} class={"px-3 py-2 rounded-md text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100"}>
              Marketplace
            </.link>
          </nav>

          <div class="flex items-center gap-3">
            <a href={~p"/logout"} class="text-sm font-medium text-gray-600 hover:text-gray-900">
              Logout
            </a>
          </div>
        </div>
      </div>
    </header>
  <% end %>

  <!-- Flash Messages -->
  <%= if Phoenix.Flash.get(@flash, :info) do %>
    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4">
      <p class="text-sm text-blue-700">
        <%= Phoenix.Flash.get(@flash, :info) %>
      </p>
    </div>
  <% end %>
  
  <%= if Phoenix.Flash.get(@flash, :error) do %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-4">
      <p class="text-sm text-red-700">
        <%= Phoenix.Flash.get(@flash, :error) %>
      </p>
    </div>
  <% end %>

  <!-- Page Content -->
  <main>
    <%= if assigns[:inner_content] do %>
      <%= @inner_content %>
    <% else %>
      <%= render_slot(@inner_block) %>
    <% end %>
  </main>
</div>
