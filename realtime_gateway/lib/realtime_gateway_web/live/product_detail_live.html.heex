<div class="min-h-screen bg-gray-50 flex flex-col">
  <RealtimeGatewayWeb.Layouts.navbar profile={@profile} active_tab={:marketplace} notifications={@notifications} />

  <main class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 flex-1 w-full space-y-6">
    <.link navigate={~p"/products"} class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-900 transition">
      <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Back to Marketplace
    </.link>

    <%= if @loading do %>
      <div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-200 p-12 text-center animate-pulse">
        <div class="h-8 bg-gray-200 rounded w-1/4 mx-auto mb-4"></div>
        <div class="h-4 bg-gray-200 rounded w-1/2 mx-auto"></div>
      </div>
    <% else %>
      <%= if @error do %>
        <div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-200 p-12 text-center">
          <svg class="mx-auto h-12 w-12 text-red-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <h3 class="text-lg font-bold text-gray-900">Error Loading Product</h3>
          <p class="text-sm text-gray-500 mt-2"><%= @error %></p>
        </div>
      <% else %>
        <div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-200 overflow-hidden">
          <div class="grid grid-cols-1 md:grid-cols-2">
            
            <%!-- Left: Image Gallery --%>
            <div class="bg-gray-100 p-8 flex items-center justify-center min-h-[300px] border-b md:border-b-0 md:border-r border-gray-100">
               <%= if @product["images"] && length(@product["images"]) > 0 do %>
                 <img src={hd(@product["images"])} class="max-w-full max-h-[400px] object-contain drop-shadow-md rounded-lg" alt={@product["name"]} />
                 <%!-- Additional images could be iterated here --%>
               <% else %>
                 <svg class="h-24 w-24 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
               <% end %>
            </div>

            <%!-- Right: Product Info --%>
            <div class="p-8 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 uppercase tracking-wide border border-green-100">
                    <%= @product["category"] || "Product" %>
                  </span>
                  <%= if @product["isAvailable"] do %>
                    <span class="flex items-center text-xs font-medium text-green-600">
                      <span class="w-2 h-2 rounded-full bg-green-500 mr-1.5 animate-pulse"></span>
                      In Stock
                    </span>
                  <% else %>
                     <span class="flex items-center text-xs font-medium text-red-600">
                      <span class="w-2 h-2 rounded-full bg-red-500 mr-1.5"></span>
                      Sold Out
                    </span>
                  <% end %>
                </div>
                
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight leading-tight mb-2"><%= @product["name"] %></h1>
                
                <div class="flex items-baseline gap-2 mb-6">
                  <span class="text-4xl font-bold text-gray-900"><%= @product["price"] %> <span class="text-base font-semibold text-gray-500">MAD</span></span>
                  <span class="text-gray-400">/ <%= @product["unit"] %></span>
                </div>

                <div class="prose prose-sm text-gray-500 mb-8 border-t border-gray-100 pt-6">
                  <h3 class="text-sm font-semibold text-gray-900 mb-2 uppercase tracking-wide">Description</h3>
                  <p><%= @product["description"] || "No additional description provided by the seller." %></p>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-8">
                  <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                    <span class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Available Quantity</span>
                    <span class="text-lg font-bold text-gray-900"><%= @product["quantity"] %> <%= @product["unit"] %></span>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                    <span class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Seller</span>
                    <span class="text-lg font-bold text-gray-900 truncate"><%= if @product["farmer"], do: @product["farmer"]["name"], else: "Unknown" %></span>
                  </div>
                   <div class="bg-gray-50 rounded-xl p-4 border border-gray-100 col-span-2 flex items-center gap-3">
                     <div class="flex-1">
                        <span class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Location</span>
                        <span class="text-sm font-semibold text-gray-900 truncate"><%= if @product["farmer"], do: @product["farmer"]["location"], else: "Location hidden" %></span>
                     </div>
                     <%= if @product["farmer"] && @product["farmer"]["rating"] do %>
                     <div class="flex flex-col items-end">
                       <span class="block text-xs font-medium text-amber-500 uppercase tracking-wide mb-1">Rating</span>
                       <div class="flex items-center text-amber-400 gap-1 font-bold text-sm">
                         <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                         <%= @product["farmer"]["rating"] %>
                       </div>
                     </div>
                     <% end %>
                  </div>
                </div>
              </div>

              <%= if @product["farmer"] && @profile && @product["farmer"]["id"] == @profile["id"] do %>
                 <div class="bg-blue-50 text-blue-800 rounded-xl p-4 text-sm font-medium border border-blue-100 text-center">
                    This is your own product listing. Head to your <.link navigate={~p"/dashboard"} class="font-bold underline cursor-pointer hover:text-blue-900">Dashboard</.link> to edit it.
                 </div>
              <% else %>
                 <button 
                  class={"w-full flex items-center justify-center py-4 px-8 border border-transparent rounded-xl shadow-sm text-base font-bold text-white transition focus:outline-none focus:ring-2 focus:ring-offset-2 #{if @product["isAvailable"], do: "bg-green-600 hover:bg-green-700 focus:ring-green-500", else: "bg-gray-400 cursor-not-allowed opacity-80"}"}
                  disabled={!@product["isAvailable"]}
                  phx-click="start_negotiation"
                  phx-value-product_id={@product["id"]}
                 >
                   <%= if @product["isAvailable"], do: "Negotiate Price", else: "Currently Unavailable" %>
                 </button>
              <% end %>
            </div>

          </div>
        </div>
      <% end %>
    <% end %>
  </main>
</div>
